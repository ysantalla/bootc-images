[Desktop Entry]
TryExec=/var/lib/flatpak/exports/bin/com.slack.Slack
X-Bootc-Images-Managed=true
Categories=GNOME;GTK;Network;InstantMessaging;
Comment=Slack Desktop
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=com.slack.Slack --file-forwarding com.slack.Slack --enable-features=UseOzonePlatform,WebRTCPipeWireCapturer --ozone-platform=wayland @@u %U @@
GenericName=Slack Client for Linux
Icon=com.slack.Slack
MimeType=x-scheme-handler/slack;
Name=Slack
NoDisplay=false
Path=
PrefersNonDefaultGPU=false
StartupNotify=true
StartupWMClass=Slack
Terminal=false
TerminalOptions=
Type=Application
X-Desktop-File-Install-Version=0.28
X-Flatpak=com.slack.Slack
X-Flatpak-RenamedFrom=slack.desktop;
X-GNOME-UsesNotifications=true
X-KDE-SubstituteUID=false
X-KDE-Username=
