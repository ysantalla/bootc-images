[Unit]
Description=bootc-images: download the new image (applied on next reboot)
Wants=network-online.target
After=network-online.target
ConditionACPower=true

[Service]
Type=oneshot
# A stalled download would otherwise block every later run until a reboot
TimeoutStartSec=2h
ExecCondition=/usr/libexec/bootc-images/update-allowed.sh
ExecStart=/usr/bin/bootc upgrade
ExecStartPost=/usr/libexec/bootc-images/update-state.sh
