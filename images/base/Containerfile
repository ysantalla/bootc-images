# base: near-stock Kinoite (codecs and Podman from kinoite-main) plus the layer every machine shares.
# No Docker engine, no libvirt. Hardware-agnostic: every machine image builds FROM this one.
#
# Pin the Fedora version and bump it on purpose.
ARG FEDORA_VERSION=45
ARG BASE_IMAGE=ghcr.io/ublue-os/kinoite-main

# Build context: these scripts never end up in the final image
FROM scratch AS ctx
COPY build_files /

FROM ${BASE_IMAGE}:${FEDORA_VERSION}

# Our own version, so `bootc status` and the update notification show this build
# instead of the version label inherited from upstream. CI passes the build date.
ARG FEDORA_VERSION
ARG BUILD_DATE=local
LABEL org.opencontainers.image.version="${FEDORA_VERSION}.${BUILD_DATE}"

# Our files: scripts in /usr/libexec, units in /usr/lib/systemd, lists in /usr/share
COPY system_files/ /

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh

RUN bootc container lint
