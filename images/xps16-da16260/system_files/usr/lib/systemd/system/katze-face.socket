[Unit]
Description=Katze: face unlock with the infrared camera
ConditionPathExists=/sys/class/leds/HIMX1092_00::ir_flood_led

[Socket]
ListenStream=/run/katze-face.sock
# Anyone may ask, and only for themselves: katze-face reads who is asking from the socket, and only
# turns the camera on for the user logind has at the screen; anyone else gets "no" at once
SocketMode=0666
Accept=yes
# The camera itself has one reader at a time (katze-ir-camera.socket). A few here, so that quick "no"
# answers to other accounts cannot take the lock screen's turn
MaxConnections=4

[Install]
WantedBy=sockets.target
